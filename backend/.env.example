# Server
PORT=5000
NODE_ENV=production

# Database
# When deploying to Render, set the DATABASE_URL environment variable
# in your Render service's dashboard.
DATABASE_URL=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=https://your-frontend-service.onrender.com

# Gmail SMTP
GMAIL_USER=you@example.com
GMAIL_PASSWORD=your_gmail_app_password
